{
  "name": "supabase-express-api",
  "version": "1.0.0",
  "description": "Multi-tenant Express API with Supabase auth, Drizzle ORM and audit logging",
  "main": "dist/server.mjs",
  "module": "dist/server.mjs",
  "type": "module",
  "imports": {
    "@": "./src"
  },
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "lint:check": "eslint . --max-warnings 0",
    "format": "prettier -w '**/*.{js,ts,mjs,cjs,json,tsx,jsx}'",
    "format:check": "prettier --check '**/*.{js,ts,mjs,cjs,json,tsx,jsx}'",
    "tsc:check": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch ./src/server.ts | pino-pretty",
    "build": "pkgroll",
    "build:tsc": "rm -rf dist && tsc -p tsconfig.json",
    "test": "vitest --run --coverage",
    "migrate:create": "drizzle-kit generate",
    "migrate": "drizzle-kit migrate",
    "migrate:push": "drizzle-kit push",
    "seed": "tsx ./src/services/db/seed.ts --supabase=$npm_config_supabase",
    "dev:workspace": "tsx ./scripts/dev-setup.ts --email=$npm_config_email --name=$npm_config_name",
    "dev:workspaces": "tsx ./scripts/dev-setup.ts --email=$npm_config_email",
    "token-test": "tsx ./scripts/token-test.ts",
    "studio": "drizzle-kit studio"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-v8": "^2.0.0",
    "dotenv": "^16.4.5",
    "drizzle-kit": "^0.31.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "globals": "^15.0.0",
    "pino-pretty": "^13.0.0",
    "pkgroll": "^2.1.1",
    "prettier": "^3.2.5",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.29.0",
    "vitest": "^2.0.0",
    "zod": "^4.0.10"
  },
  "files": [
    "dist"
  ],
  "volta": {
    "node": "22.16.0"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.0.0",
    "@sentry/node": "^9.11.0",
    "@sentry/profiling-node": "^9.11.0",
    "@supabase/supabase-js": "^2.43.4",
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.13",
    "@types/pg": "^8.11.6",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.44.0",
    "drizzle-zod": "^0.8.0",
    "express": "^4.19.2",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.0.0",
    "pg": "^8.14.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "swagger-ui-express": "^5.0.1"
  },
  "pnpm": {
    "minimumReleaseAge": 1440,
    "onlyBuiltDependencies": [
      "@sentry/profiling-node",
      "bcrypt",
      "esbuild"
    ]
  }
}
